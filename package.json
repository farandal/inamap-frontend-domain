{
  "name": "inamap-frontend-domain",
  "private": true,
  "version": "1.0.0",
  "description": "INAMAP — frontend del dominio (apps inamap-web, inamap-system, inamap-app y paquetes ina-*) sobre el framework DashAdmin",
  "license": "UNLICENSED",
  "scripts": {
    "_INFO": "Apps: inamap-web (tenants), inamap-system (plataforma), inamap-app (visor público). Entorno por app: apps/<app>/.env.<app>.<entorno> (DashAdmin) o apps/inamap-app/.env.local.",
    "dev:web": "cross-env CUSTOM_MODE=inamap-web.local TARGET_TYPE=web PLATFORM=web pnpm --filter inamap-web dev",
    "dev:system": "cross-env CUSTOM_MODE=inamap-system.local TARGET_TYPE=web PLATFORM=web pnpm --filter inamap-system dev",
    "dev:app": "pnpm --filter inamap-app dev",
    "build:packages": "pnpm -r --filter './packages/ina-*' run build",
    "build:web": "cross-env CUSTOM_MODE=inamap-web.${INAMAP_ENV:-local} TARGET_TYPE=web PLATFORM=web pnpm --filter inamap-web build",
    "build:system": "cross-env CUSTOM_MODE=inamap-system.${INAMAP_ENV:-local} TARGET_TYPE=web PLATFORM=web pnpm --filter inamap-system build",
    "build:app": "pnpm --filter inamap-app build",
    "build": "pnpm build:packages && pnpm build:web && pnpm build:system && pnpm build:app",
    "typecheck": "pnpm -r --filter './packages/ina-*' --filter inamap-app run typecheck",
    "test": "pnpm --filter ina-viewer test"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=9.6.7"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/error-message": "^2.0.1",
    "@mui/icons-material": "^9.3.0",
    "@mui/material": "^9.3.0",
    "@mui/system": "^9.3.0",
    "@mui/utils": "^9.3.0",
    "@mui/x-date-pickers": "^9.10.1",
    "@react-oauth/google": "^0.13.4",
    "@reduxjs/toolkit": "^2.8.2",
    "@rooks/use-previous": "^4.11.2",
    "@tanstack/react-query": "5.101.2",
    "axios": "^1.11.0",
    "clsx": "^2.1.1",
