    "cross-env": "^7.0.3",
    "dash-eslint": "npm:@dashadmin/dash-eslint@^1.3.47",
    "dash-prettier": "npm:@dashadmin/dash-prettier@^1.3.47",
    "dash-tsconfig": "npm:@dashadmin/dash-tsconfig@^1.3.47",
    "npm-run-all": "latest",
    "postcss": "latest",
    "prettier": "latest",
    "terser": "5.19.2",
    "tsup": "^8.5.0",
    "turbo": "latest",
