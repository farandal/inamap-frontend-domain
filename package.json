    "dash-styles": "npm:@dashadmin/dash-styles@^1.3.47",
    "dash-utils": "npm:@dashadmin/dash-utils@^1.3.47",
    "embla-carousel-react": "^8.6.0",
    "file-saver": "^2.0.5",
    "js-cookie": "^3.0.5",
    "laravel-echo": "^2.2.0",
    "lodash": "^4.17.21",
    "material-react-table": "^3.2.1",
    "pusher-js": "^8.4.0",
    "ra-core": "5.15.0",
    "ra-data-simple-rest": "5.15.0",
    "ra-i18n-polyglot": "5.15.0",
    "ra-language-english": "5.15.0",
    "ra-language-spanish": "^1.0.0",
    "ra-ui-materialui": "5.15.1",
