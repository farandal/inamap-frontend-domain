    "dash-admin": "npm:@dashadmin/dash-admin@^1.3.47",
    "dash-admin-state": "npm:@dashadmin/dash-admin-state@^1.3.47",
    "dash-app-common": "npm:@dashadmin/dash-app-common@^1.3.47",
    "dash-auth": "npm:@dashadmin/dash-auth@^1.3.47",
    "dash-auto-admin": "npm:@dashadmin/dash-auto-admin@^1.3.47",
    "dash-axios-hook": "npm:@dashadmin/dash-axios-hook@^1.3.47",
    "dash-boilerplate": "npm:@dashadmin/dash-boilerplate@^1.3.47",
    "dash-components": "npm:@dashadmin/dash-components@^1.3.47",
    "dash-constants": "npm:@dashadmin/dash-constants@^1.3.47",
    "dash-dialog": "npm:@dashadmin/dash-dialog@^1.3.47",
    "dash-icons": "npm:@dashadmin/dash-icons@^1.3.47",
    "dash-info": "npm:@dashadmin/dash-info@^1.3.47",
    "dash-interfaces": "npm:@dashadmin/dash-interfaces@^1.3.47",
