# inamap-web — entorno local. Copie a .env.inamap-web.local (no va a git).
# Se carga con CUSTOM_MODE=inamap-web.local (ver scripts del package.json raíz).
VITE_ENV_PREFIX='VITE_'

VITE_APP_FRONTEND_URL=http://localhost:5181
VITE_APP_BACKEND_URL=http://localhost:25200
VITE_APP_ADMIN_API_URL=http://localhost:25200/api
# Visor público (inamap-app): destino de enlaces y QR.
VITE_APP_INAMAP_APP_URL=http://localhost:5180

VITE_DEV_PORT=5181
VITE_DEV_HOST=0.0.0.0
VITE_HMR_HOST=localhost
VITE_HMR_PORT=5281

VITE_APP_DEFAULT_REDIRECT=/dash
VITE_APP_GETAUTH_ENDPOINT='auth/getauth'

# Websockets (Reverb del backend: REVERB_APP_KEY de inamap-backend-docker/.env.app.local)
VITE_APP_SOCKETS_ENABLED=true
VITE_APP_SOCKETS_BROADCASTER=pusher
VITE_APP_SOCKETS_HOST=localhost
VITE_APP_SOCKETS_PORT=27001
VITE_APP_SOCKETS_SCHEME=http
VITE_APP_SOCKETS_KEY=
VITE_APP_SOCKETS_AUTH_ENDPOINT=api/ws/auth

VITE_SIDEBAR_WIDH=280
VITE_SIDEBAR_COLLAPSED_WIDH=80
VITE_DASH_ADMIN_ROLE='System'
VITE_ENABLE_TENANT_LOGIC=true
VITE_ENABLE_TENANT_IMPERSONATION=true
VITE_ENABLE_LOGS_AND_NOTIFICATIONS=false
VITE_FILTERS_COLLAPSE_COUNT=5
VITE_FILTERS_COLLAPSE_SIZE="0px"

VITE_APP_RECAPTCHA_ENABLED=false
VITE_APP_RECAPTCHA_TOKEN=

# "pre-release" muestra la portada de próximamente y exige código de invitación al registrarse.
VITE_APP_RELEASE_STAGE=release
VITE_APP_PRERELEASE_INVITATION_CODE=
